# ==============================================================================
# Sai Yadadri Seva Ashram Platform — Docker Compose Environment Variables
# Copy this file to .env (repo root) for `docker compose up`. Never commit .env.
# App-level variables (with more detail/options) live in apps/api/.env.example
# and apps/web/.env.example — this file is specifically for orchestration.
# ==============================================================================

# --- Public URLs ---
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Port mappings (host side) ---
API_PORT=4000
WEB_PORT=3000
MYSQL_PORT=3306
NGINX_HTTP_PORT=80

# --- Database (MySQL 8.0+, utf8mb4 / utf8mb4_0900_ai_ci — see MYSQL_MIGRATION_REPORT.md) ---
MYSQL_ROOT_PASSWORD=change-me-in-production
MYSQL_USER=sysa_user
MYSQL_PASSWORD=change-me-in-production
MYSQL_DATABASE=sysa_db

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret-at-least-32-characters

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@sysaindia.org

# --- Logging ---
LOG_LEVEL=info
