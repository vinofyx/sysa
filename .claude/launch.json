{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=website"],
      "port": 3030,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/d", "/c", ".claude\\dev-api.bat"],
      "port": 5050,
      "autoPort": true
    },
    {
      "name": "static-export-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "5060", "website/out"],
      "port": 5060
    },
    {
      "name": "local-full-stack-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["website/scripts/local-proxy.mjs", "5060"],
      "port": 5060
    }
  ]
}
