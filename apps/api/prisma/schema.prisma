// ==============================================================================
// Sai Yadadri Seva Ashram Platform — Prisma Schema
//
// Implements the data model defined in:
//   - documentation/08-Database-Requirements.md (Phase 1 — entities & business rules)
//   - design/12-Database-ERD.md (Phase 2 — full cardinalities & bilingual pattern)
//
// Phase 4 additions: production authentication (sessions/refresh-token rotation,
// password reset, email verification, account lockout) and an expanded, fully
// configurable RBAC role set — see DEVELOPMENT_PROGRESS.md for the reconciliation
// note against the simpler 4-role matrix in documentation/10-Roles-and-Permissions.md.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// RBAC — documentation/10-Roles-and-Permissions.md
// ------------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  adminUsers      AdminUser[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model AdminUser {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String    @map("password_hash")
  roleId              String    @map("role_id")
  active              Boolean   @default(true)
  emailVerified       Boolean   @default(false) @map("email_verified")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime? @map("password_changed_at")
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  role                    Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs               AuditLog[]
  authoredPosts           EventNewsPost[]          @relation("PostAuthor")
  uploadedDocuments       DocumentRepo[]           @relation("DocumentUploader")
  reviewedApplications    VolunteerApplication[]   @relation("ApplicationReviewer")
  updatedPageContents     PageContent[]            @relation("PageContentEditor")
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  verifiedBankTransfers   BankTransferRecord[]     @relation("BankTransferVerifier")
  assignedVolunteerTasks  VolunteerAssignment[]    @relation("AssignmentAssignedBy")
  createdEvents           Event[]                  @relation("EventCreatedBy")
  updatedSiteSettings     SiteSettings[]           @relation("SiteSettingsEditor")

  @@index([roleId])
  @@index([email])
  @@map("admin_user")
}

/// One row per active login (device/browser). The JWT access token's `sid` claim
/// references this row's id, so authorization can be revoked immediately
/// (logout / logout-all-devices) rather than waiting for short-lived access-token
/// expiry — see design/13-API-Architecture.md §4.1 and apps/api/src/services/auth.service.ts.
model Session {
  id               String    @id @default(uuid())
  adminUserId      String    @map("admin_user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, revokedAt])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("email_verification_token")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String   @map("admin_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  timestamp   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, timestamp])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ------------------------------------------------------------------------------
// Donations — documentation/08-Database-Requirements.md §3.1-3.5, design/12-Database-ERD.md §3
// ------------------------------------------------------------------------------

enum DonorTier {
  one_time
  monthly
  major
  csr
}

model Donor {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  phone            String
  panNumberMasked  String?   @map("pan_number_masked")
  recognitionOptIn Boolean   @default(false) @map("recognition_opt_in")
  donorTier        DonorTier @default(one_time) @map("donor_tier")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  donations Donation[]

  @@map("donor")
}

model DonationCategory {
  id             String   @id @default(uuid())
  code           String   @unique
  nameEn         String   @map("name_en")
  nameTe         String?  @map("name_te")
  descriptionEn  String?  @map("description_en")
  descriptionTe  String?  @map("description_te")
  hasPresetTiers Boolean  @default(false) @map("has_preset_tiers")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  donations           Donation[]
  appeals             Appeal[]
  bankTransferRecords BankTransferRecord[]
  activities          Activity[]

  @@map("donation_category")
}

enum PaymentMethod {
  upi
  card
  netbanking
  wallet
  bank_transfer_manual
  cash
  cheque
}

enum DonationStatus {
  pending
  completed
  failed
  refunded
}

enum DonationSource {
  online
  manual
}

/// Distinguishes a single gift from a recurring pledge — the "One-Time
/// Donations" vs. "Monthly Donations" split requested for Phase 5. Actual
/// recurring-charge automation (re-billing a monthly donor) is a Razorpay
/// Subscriptions integration deferred to the Donation Platform phase
/// (documentation/03-Functional-Requirements.md FR-DON-08); this field lets
/// the admin classify/report on a donation's intended frequency starting now.
enum DonationFrequency {
  one_time
  monthly
}

model Donation {
  id                String            @id @default(uuid())
  donorId           String            @map("donor_id")
  categoryId        String            @map("category_id")
  appealId          String?           @map("appeal_id")
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("INR")
  paymentMethod     PaymentMethod     @map("payment_method")
  paymentGatewayRef String?           @map("payment_gateway_ref")
  status            DonationStatus    @default(pending)
  source            DonationSource    @default(online)
  frequency         DonationFrequency @default(one_time)
  internalNote      String?           @map("internal_note")
  createdAt         DateTime          @default(now()) @map("created_at")
  completedAt       DateTime?         @map("completed_at")

  donor             Donor               @relation(fields: [donorId], references: [id], onDelete: Restrict)
  category          DonationCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  appeal            Appeal?             @relation(fields: [appealId], references: [id], onDelete: SetNull)
  receipt           Receipt?
  bankTransferClaim BankTransferRecord?

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([donorId])
  @@index([frequency])
  @@map("donation")
}

enum BankTransferStatus {
  pending_verification
  verified
  rejected
}

/// A donor's self-reported "I've made a bank transfer/UPI payment" claim
/// (design/03-User-Flows.md F-03) — separate from `Donation` because it starts
/// as an unverified claim; a Finance Admin cross-checks it against the bank
/// statement and only then creates/links the authoritative `Donation` record.
model BankTransferRecord {
  id                String             @id @default(uuid())
  donorName         String             @map("donor_name")
  donorEmail        String?            @map("donor_email")
  donorPhone        String?            @map("donor_phone")
  categoryId        String             @map("category_id")
  amount            Decimal            @db.Decimal(12, 2)
  bankReferenceUtr  String?            @map("bank_reference_utr")
  submittedAt       DateTime           @default(now()) @map("submitted_at")
  status            BankTransferStatus @default(pending_verification)
  verifiedByAdminId String?            @map("verified_by_admin_id")
  linkedDonationId  String?            @unique @map("linked_donation_id")
  internalNote      String?            @map("internal_note")

  category        DonationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  verifiedByAdmin AdminUser?       @relation("BankTransferVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  linkedDonation  Donation?        @relation(fields: [linkedDonationId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@map("bank_transfer_record")
}

model Receipt {
  id            String   @id @default(uuid())
  donationId    String   @unique @map("donation_id")
  receiptNumber String   @unique @map("receipt_number")
  pdfUrl        String?  @map("pdf_url")
  issuedAt      DateTime @default(now()) @map("issued_at")

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@map("receipt")
}

enum AppealStatus {
  active
  completed
  archived
}

model Appeal {
  id                String       @id @default(uuid())
  categoryId        String       @map("category_id")
  titleEn           String       @map("title_en")
  titleTe           String?      @map("title_te")
  descriptionEn     String?      @map("description_en")
  descriptionTe     String?      @map("description_te")
  targetAmount      Decimal      @map("target_amount") @db.Decimal(12, 2)
  raisedAmountCache Decimal      @default(0) @map("raised_amount_cache") @db.Decimal(12, 2)
  startDate         DateTime?    @map("start_date") @db.Date
  endDate           DateTime?    @map("end_date") @db.Date
  status            AppealStatus @default(active)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  category  DonationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  donations Donation[]

  @@map("appeal")
}

// ------------------------------------------------------------------------------
// Committee — documentation/09-Admin-Modules.md §11, design/04-Admin-Flows.md AF-08
// ------------------------------------------------------------------------------

model CommitteeMember {
  id           String    @id @default(uuid())
  name         String
  designation  String
  displayOrder Int       @map("display_order")
  photoUrl     String?   @map("photo_url")
  bioEn        String?   @map("bio_en")
  bioTe        String?   @map("bio_te")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([displayOrder])
  @@index([deletedAt])
  @@map("committee_member")
}

// ------------------------------------------------------------------------------
// Events, News, Gallery — documentation/07-System-Modules.md §3.7-3.8
// ------------------------------------------------------------------------------

enum PostType {
  event
  news
}

enum PostStatus {
  draft
  published
  archived
}

/// Blog/News posts. `type` is retained from Phase 3 for backward compatibility,
/// but Phase 5 introduces a dedicated, richer `Event` model (below) for actual
/// events (categories, registrations, attendance) — new code should only create
/// rows here with `type = news`.
model EventNewsPost {
  id                String     @id @default(uuid())
  type              PostType
  titleEn           String     @map("title_en")
  titleTe           String?    @map("title_te")
  bodyEn            String?    @map("body_en")
  bodyTe            String?    @map("body_te")
  slug              String     @unique
  eventDate         DateTime?  @map("event_date") @db.Date
  publishedAt       DateTime?  @map("published_at")
  status            PostStatus @default(draft)
  featuredImageUrl  String?    @map("featured_image_url")
  /// News-only (`type='news'`) categorization — Phase 6 public site
  /// requirement (category filter + tags). Nullable/empty on events, which
  /// don't use this field.
  category          String?
  tags              String[]   @default([])
  metaTitleEn       String?    @map("meta_title_en")
  metaDescriptionEn String?    @map("meta_description_en")
  authorAdminId     String?    @map("author_admin_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  author AdminUser? @relation("PostAuthor", fields: [authorAdminId], references: [id], onDelete: SetNull)

  @@index([type, publishedAt])
  @@index([deletedAt])
  @@map("event_news_post")
}

model GalleryAlbum {
  id           String    @id @default(uuid())
  nameEn       String    @map("name_en")
  nameTe       String?   @map("name_te")
  category     String?
  /// Optional link so an album can double as an event's photo gallery
  /// ("Event Gallery" — Phase 5 Event module requirement).
  eventId      String?   @map("event_id")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  items GalleryItem[]
  event Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("gallery_album")
}

enum MediaType {
  image
  video
}

model GalleryItem {
  id                 String    @id @default(uuid())
  albumId            String    @map("album_id")
  mediaType          MediaType @map("media_type")
  mediaUrl           String    @map("media_url")
  /// Cloudinary asset id — needed to delete/re-transform the asset later
  /// (not derivable from `mediaUrl` alone once transformations are applied).
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  altTextEn          String?   @map("alt_text_en")
  altTextTe          String?   @map("alt_text_te")
  displayOrder       Int       @default(0) @map("display_order")
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, displayOrder])
  @@index([deletedAt])
  @@map("gallery_item")
}

// ------------------------------------------------------------------------------
// Volunteers — documentation/08-Database-Requirements.md §3.9
// ------------------------------------------------------------------------------

model Volunteer {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String
  registeredAt DateTime @default(now()) @map("registered_at")

  applications VolunteerApplication[]
  assignments  VolunteerAssignment[]

  @@index([email])
  @@map("volunteer")
}

enum VolunteerApplicationType {
  volunteer
  internship
}

enum VolunteerApplicationStatus {
  submitted
  under_review
  accepted
  not_selected
}

model VolunteerApplication {
  id                 String                     @id @default(uuid())
  volunteerId        String                     @map("volunteer_id")
  type               VolunteerApplicationType
  academicBackground String?                    @map("academic_background")
  areaOfInterest     String?                    @map("area_of_interest")
  resumeUrl          String?                    @map("resume_url")
  status             VolunteerApplicationStatus @default(submitted)
  internalNote       String?                    @map("internal_note")
  reviewedBy         String?                    @map("reviewed_by")
  submittedAt        DateTime                   @default(now()) @map("submitted_at")
  statusUpdatedAt    DateTime?                  @updatedAt @map("status_updated_at")

  volunteer Volunteer  @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  reviewer  AdminUser? @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("volunteer_application")
}

// ------------------------------------------------------------------------------
// Documents & Contact — documentation/07-System-Modules.md §3.9, §3.11
// ------------------------------------------------------------------------------

/// `certificate_12ab` covers the client's "12A" ask — 12AB is the current form
/// of that certificate under Indian tax law since the 12A regime was
/// superseded; no separate `certificate_12a` value is added to avoid modeling
/// a form that no longer exists.
enum DocumentCategory {
  registration_certificate
  certificate_12ab
  certificate_80g
  pan_card
  annual_report
  audit_report
  financial_statement
}

model DocumentRepo {
  id                 String           @id @default(uuid())
  category           DocumentCategory
  titleEn            String           @map("title_en")
  titleTe            String?          @map("title_te")
  fileUrl            String           @map("file_url")
  cloudinaryPublicId String?          @map("cloudinary_public_id")
  publishedDate      DateTime?        @map("published_date") @db.Date
  publicVisible      Boolean          @default(false) @map("public_visible")
  uploadedBy         String?          @map("uploaded_by")
  createdAt          DateTime         @default(now()) @map("created_at")
  deletedAt          DateTime?        @map("deleted_at")

  uploader AdminUser? @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([category, publicVisible])
  @@index([deletedAt])
  @@map("document_repo")
}

enum ContactSubmissionStatus {
  new
  in_progress
  resolved
}

model ContactSubmission {
  id          String                  @id @default(uuid())
  name        String
  email       String
  phone       String?
  message     String
  status      ContactSubmissionStatus @default(new)
  submittedAt DateTime                @default(now()) @map("submitted_at")

  @@map("contact_submission")
}

/// Public website newsletter signup (Phase 6) — deliberately minimal (just an
/// email + subscribed flag) since no email-campaign/newsletter-sending system
/// exists in this project's scope yet; this only captures interest.
model NewsletterSubscriber {
  id           String    @id @default(uuid())
  email        String    @unique
  subscribed   Boolean   @default(true)
  subscribedAt DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@map("newsletter_subscriber")
}

// ------------------------------------------------------------------------------
// CMS singleton content — design/12-Database-ERD.md §4 "page_content"
// ------------------------------------------------------------------------------

model PageContent {
  id        String   @id @default(uuid())
  pageKey   String   @unique @map("page_key")
  blocksEn  Json     @map("blocks_en")
  blocksTe  Json?    @map("blocks_te")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  editor AdminUser? @relation("PageContentEditor", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("page_content")
}

// ==============================================================================
// Phase 5 — Business Modules & Content Management System
// ==============================================================================

// ------------------------------------------------------------------------------
// Homepage / marketing content — documentation/03-Functional-Requirements.md
// FR-HOME-05 (testimonials), FR-HOME-01 (hero banner)
// ------------------------------------------------------------------------------

model Testimonial {
  id           String    @id @default(uuid())
  authorName   String    @map("author_name")
  authorRole   String?   @map("author_role")
  quoteEn      String    @map("quote_en")
  quoteTe      String?   @map("quote_te")
  photoUrl     String?   @map("photo_url")
  displayOrder Int       @default(0) @map("display_order")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([active, displayOrder])
  @@index([deletedAt])
  @@map("testimonial")
}

model HeroBanner {
  id           String    @id @default(uuid())
  titleEn      String    @map("title_en")
  titleTe      String?   @map("title_te")
  subtitleEn   String?   @map("subtitle_en")
  subtitleTe   String?   @map("subtitle_te")
  imageUrl     String    @map("image_url")
  ctaLabelEn   String?   @map("cta_label_en")
  ctaLabelTe   String?   @map("cta_label_te")
  ctaUrl       String?   @map("cta_url")
  displayOrder Int       @default(0) @map("display_order")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([active, displayOrder])
  @@index([deletedAt])
  @@map("hero_banner")
}

enum SocialPlatform {
  facebook
  instagram
  twitter
  youtube
  linkedin
  whatsapp
}

model SocialMediaLink {
  id           String         @id @default(uuid())
  platform     SocialPlatform
  url          String
  displayOrder Int            @default(0) @map("display_order")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([platform])
  @@map("social_media_link")
}

enum NavLocation {
  header
  footer
}

/// Self-referencing for a single level of nested (dropdown) menus — matches
/// the primary/secondary nav split in design/01-Information-Architecture.md §4-5.
model NavigationMenuItem {
  id           String      @id @default(uuid())
  labelEn      String      @map("label_en")
  labelTe      String?     @map("label_te")
  url          String
  location     NavLocation
  parentId     String?     @map("parent_id")
  displayOrder Int         @default(0) @map("display_order")
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  parent   NavigationMenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationMenuItem[] @relation("MenuHierarchy")

  @@index([location, displayOrder])
  @@index([deletedAt])
  @@map("navigation_menu_item")
}

/// Singleton (always a single row, id = "default") — site-wide configuration:
/// Website Settings, Contact Information, and SEO Settings defaults, per
/// design/09-Admin-Modules.md §16 "System Settings" and the Contact Info
/// Editor in §5. Modeled as one row rather than a generic key-value table
/// because the field set is small, fixed, and known in advance.
model SiteSettings {
  id                     String   @id @default("default")
  siteNameEn             String   @default("Sai Yadadri Seva Ashram") @map("site_name_en")
  siteNameTe             String?  @map("site_name_te")
  taglineEn              String?  @map("tagline_en")
  taglineTe              String?  @map("tagline_te")
  logoUrl                String?  @map("logo_url")
  faviconUrl             String?  @map("favicon_url")
  contactAddressEn       String?  @map("contact_address_en")
  contactAddressTe       String?  @map("contact_address_te")
  contactPhone           String?  @map("contact_phone")
  contactEmail           String?  @map("contact_email")
  contactHoursEn         String?  @map("contact_hours_en")
  whatsappNumber         String?  @map("whatsapp_number")
  mapLatitude            Decimal? @map("map_latitude") @db.Decimal(9, 6)
  mapLongitude           Decimal? @map("map_longitude") @db.Decimal(9, 6)
  defaultMetaTitle       String?  @map("default_meta_title")
  defaultMetaDescription String?  @map("default_meta_description")
  defaultOgImageUrl      String?  @map("default_og_image_url")
  footerTextEn           String?  @map("footer_text_en")
  footerTextTe           String?  @map("footer_text_te")
  copyrightText          String?  @map("copyright_text")
  maintenanceMode        Boolean  @default(false) @map("maintenance_mode")
  /// Bank transfer / UPI details shown on the public Donate page — nullable
  /// like every other settings field (Phase 6), never fabricated defaults.
  bankAccountName        String?  @map("bank_account_name")
  bankAccountNumber      String?  @map("bank_account_number")
  bankIfscCode           String?  @map("bank_ifsc_code")
  bankName               String?  @map("bank_name")
  bankBranch             String?  @map("bank_branch")
  upiId                  String?  @map("upi_id")
  upiQrImageUrl          String?  @map("upi_qr_image_url")
  updatedAt              DateTime @updatedAt @map("updated_at")
  updatedBy              String?  @map("updated_by")

  editor AdminUser? @relation("SiteSettingsEditor", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

/// Covers both "Activities" and "Services" from the Phase 5 CMS list — no
/// separate "Services" concept exists anywhere in the Phase 1/2 source-of-truth
/// documents, so the two are modeled as one entity rather than inventing a
/// second, functionally-identical table (see DEVELOPMENT_PROGRESS.md).
model Activity {
  id               String    @id @default(uuid())
  slug             String    @unique
  titleEn          String    @map("title_en")
  titleTe          String?   @map("title_te")
  descriptionEn    String?   @map("description_en")
  descriptionTe    String?   @map("description_te")
  iconOrImageUrl   String?   @map("icon_or_image_url")
  linkedCategoryId String?   @map("linked_category_id")
  displayOrder     Int       @default(0) @map("display_order")
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  linkedCategory DonationCategory? @relation(fields: [linkedCategoryId], references: [id], onDelete: SetNull)

  @@index([active, displayOrder])
  @@index([deletedAt])
  @@map("activity")
}

// ------------------------------------------------------------------------------
// Volunteer assignments — documentation/07-System-Modules.md volunteer domain,
// extended in Phase 5 for the Volunteer Coordinator's day-to-day task tracking.
// ------------------------------------------------------------------------------

enum AssignmentStatus {
  assigned
  in_progress
  completed
  cancelled
}

model VolunteerAssignment {
  id                String           @id @default(uuid())
  volunteerId       String           @map("volunteer_id")
  titleEn           String           @map("title_en")
  descriptionEn     String?          @map("description_en")
  assignedDate      DateTime         @map("assigned_date") @db.Date
  status            AssignmentStatus @default(assigned)
  assignedByAdminId String?          @map("assigned_by_admin_id")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  volunteer       Volunteer  @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  assignedByAdmin AdminUser? @relation("AssignmentAssignedBy", fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@index([volunteerId, status])
  @@map("volunteer_assignment")
}

// ------------------------------------------------------------------------------
// Events — dedicated module (categories, registrations, attendance), separate
// from the simpler EventNewsPost "news" model — see that model's doc-comment.
// ------------------------------------------------------------------------------

model EventCategory {
  id        String    @id @default(uuid())
  nameEn    String    @map("name_en")
  nameTe    String?   @map("name_te")
  slug      String    @unique
  active    Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")

  events Event[]

  @@index([deletedAt])
  @@map("event_category")
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

model Event {
  id                   String      @id @default(uuid())
  categoryId           String?     @map("category_id")
  titleEn              String      @map("title_en")
  titleTe              String?     @map("title_te")
  descriptionEn        String?     @map("description_en")
  descriptionTe        String?     @map("description_te")
  slug                 String      @unique
  startDate            DateTime    @map("start_date")
  endDate              DateTime?   @map("end_date")
  location             String?
  capacity             Int?
  registrationDeadline DateTime?   @map("registration_deadline")
  featuredImageUrl     String?     @map("featured_image_url")
  status               EventStatus @default(draft)
  metaTitleEn          String?     @map("meta_title_en")
  metaDescriptionEn    String?     @map("meta_description_en")
  createdByAdminId     String?     @map("created_by_admin_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")

  category       EventCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdByAdmin AdminUser?          @relation("EventCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  registrations  EventRegistration[]
  galleryAlbums  GalleryAlbum[]

  @@index([status, startDate])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("event")
}

enum EventRegistrationStatus {
  registered
  cancelled
  waitlisted
}

model EventRegistration {
  id           String                  @id @default(uuid())
  eventId      String                  @map("event_id")
  name         String
  email        String
  phone        String?
  registeredAt DateTime                @default(now()) @map("registered_at")
  status       EventRegistrationStatus @default(registered)
  /// "Attendance" tracking — Phase 5 Event module requirement, folded into the
  /// registration record rather than a separate table since a check-in is
  /// always 1:1 with exactly one registration.
  checkedIn    Boolean                 @default(false) @map("checked_in")
  checkedInAt  DateTime?               @map("checked_in_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("event_registration")
}
