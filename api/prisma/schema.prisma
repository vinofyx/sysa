generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  adminUsers      AdminUser[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permission_permission_id_fkey")
  @@map("role_permission")
}

model AdminUser {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  roleId                  String                   @map("role_id")
  active                  Boolean                  @default(true)
  emailVerified           Boolean                  @default(false) @map("email_verified")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  failedLoginAttempts     Int                      @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?                @map("locked_until")
  passwordChangedAt       DateTime?                @map("password_changed_at")
  lastLoginAt             DateTime?                @map("last_login_at")
  lastLoginIp             String?                  @map("last_login_ip")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  role                    Role                     @relation(fields: [roleId], references: [id])
  auditLogs               AuditLog[]
  verifiedBankTransfers   BankTransferRecord[]     @relation("BankTransferVerifier")
  uploadedDocuments       DocumentRepo[]           @relation("DocumentUploader")
  emailVerificationTokens EmailVerificationToken[]
  createdEvents           Event[]                  @relation("EventCreatedBy")
  authoredPosts           EventNewsPost[]          @relation("PostAuthor")
  updatedPageContents     PageContent[]            @relation("PageContentEditor")
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  updatedSiteSettings     SiteSettings[]           @relation("SiteSettingsEditor")
  reviewedApplications    VolunteerApplication[]   @relation("ApplicationReviewer")
  assignedVolunteerTasks  VolunteerAssignment[]    @relation("AssignmentAssignedBy")

  @@index([roleId])
  @@index([email])
  @@map("admin_user")
}

/// One row per active login (device/browser). The JWT access token's `sid` claim
/// references this row's id, so authorization can be revoked immediately
/// (logout / logout-all-devices) rather than waiting for short-lived access-token
/// expiry — see design/13-API-Architecture.md §4.1 and api/src/services/auth.service.ts.
model Session {
  id               String    @id @default(uuid())
  adminUserId      String    @map("admin_user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, revokedAt])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("email_verification_token")
}

/// `adminUserId` is nullable (Phase 7) to allow system-initiated entries — a
/// Razorpay webhook or payment-signature verification is a real security event
/// worth auditing (documentation/12-Security-Requirements.md §7) but has no
/// admin actor behind it. `onDelete: SetNull` (relaxed from `Restrict`) follows
/// from that: the log entry must survive even if the FK target goes away.
model AuditLog {
  id          String     @id @default(uuid())
  adminUserId String?    @map("admin_user_id")
  action      String
  entityType  String     @map("entity_type")
  entityId    String?    @map("entity_id")
  beforeState String?    @map("before_state") @db.LongText
  afterState  String?    @map("after_state") @db.LongText
  timestamp   DateTime   @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, timestamp])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model Donor {
  id                  String              @id @default(uuid())
  name                String
  /// Nullable: mobile (`phone`) is now the primary donor-identification
  /// field, email is an optional additional contact channel — MySQL allows
  /// multiple NULLs under a unique index, so existing donors (all of whom
  /// have a real email) are unaffected.
  email               String?             @unique
  /// Normalized to a bare 10-digit Indian mobile number (no +91/spaces) at
  /// the application layer — see `normalizeIndianMobile` (pii-mask.ts sibling
  /// util). Not `@unique` at the DB level: many pre-existing rows share the
  /// placeholder `''` from before phone was mandatory, which would violate a
  /// unique constraint. Donor matching by phone is done in app code
  /// (donor.repository.ts `findByPhone`), excluding blank phones.
  phone               String
  panNumberMasked     String?             @map("pan_number_masked")
  /// Masked to the last 4 digits only, mirroring `panNumberMasked` — the raw
  /// Aadhaar number is never stored (§ identity_fields, receipt task).
  aadhaarNumberMasked String?             @map("aadhaar_number_masked")
  address             String?             @db.Text
  city                String?
  pincode             String?
  state               String?
  recognitionOptIn    Boolean             @default(false) @map("recognition_opt_in")
  donorTier           DonorTier           @default(one_time) @map("donor_tier")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  donations           Donation[]
  subscriptions       DonorSubscription[]

  @@index([phone])
  @@map("donor")
}

model DonationCategory {
  id                  String               @id @default(uuid())
  code                String               @unique
  nameEn              String               @map("name_en")
  nameTe              String?              @map("name_te")
  descriptionEn       String?              @map("description_en") @db.Text
  descriptionTe       String?              @map("description_te") @db.Text
  hasPresetTiers      Boolean              @default(false) @map("has_preset_tiers")
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  activities          Activity[]
  appeals             Appeal[]
  bankTransferRecords BankTransferRecord[]
  donations           Donation[]
  subscriptions       DonorSubscription[]

  @@map("donation_category")
}

model Donation {
  id                    String              @id @default(uuid())
  donorId               String              @map("donor_id")
  categoryId            String              @map("category_id")
  appealId              String?             @map("appeal_id")
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("INR")
  /// Nullable: an online donation is `pending` from the moment its Razorpay
  /// order is created, before the donor has chosen how to pay — Razorpay only
  /// reports the actual method (card/upi/netbanking/wallet) once the payment
  /// is captured. Manual/bank-transfer donations still set this at creation.
  paymentMethod         PaymentMethod?      @map("payment_method")
  /// Razorpay payment ID once captured (also the field manual-entry donations
  /// have always used for an external reference) — unique so the same
  /// gateway payment can never be attached to two Donation rows.
  paymentGatewayRef     String?             @unique @map("payment_gateway_ref")
  /// Razorpay order ID, created synchronously on `/donations/initiate` — the
  /// same order can accept multiple payment attempts, which is what makes
  /// "Retry Payment" safe without creating a duplicate pending donation.
  razorpayOrderId       String?             @unique @map("razorpay_order_id")
  /// HMAC-SHA256(order_id + "|" + payment_id) returned by Razorpay Checkout,
  /// stored for audit purposes after verification succeeds.
  razorpaySignature     String?             @map("razorpay_signature")
  /// Human-readable reason a `failed` donation failed (from Razorpay's
  /// `payment.failed` webhook payload or a signature-mismatch on verify).
  failureReason         String?             @map("failure_reason")
  /// Razorpay's own payment-lifecycle vocabulary (created/authorized/
  /// captured/failed/refunded) — deliberately separate from `status` above
  /// (this app's own donation lifecycle, which drives receipt issuance and
  /// other business logic and must not change meaning). Populated at capture
  /// time and refreshed on demand via the admin "Refresh Payment Status"
  /// action or the settlement-sync job — never invented client-side.
  razorpayPaymentStatus String?             @map("razorpay_payment_status")
  /// Razorpay's transaction fee for this payment, in rupees (same unit as
  /// `amount`) — 0 for UPI (RBI's zero-MDR mandate), non-zero for card/other
  /// methods. Null until the payment has actually been fetched from Razorpay
  /// at least once.
  razorpayFee           Decimal?            @map("razorpay_fee") @db.Decimal(12, 2)
  /// GST charged on `razorpayFee`, in rupees. Null until fetched.
  razorpayTax           Decimal?            @map("razorpay_tax") @db.Decimal(12, 2)
  /// `amount - razorpayFee - razorpayTax` — what actually lands in the bank
  /// account for this payment. Null until fetched (never computed from a
  /// guess).
  netAmount             Decimal?            @map("net_amount") @db.Decimal(12, 2)
  /// Whether this specific captured payment has actually been credited to
  /// the Ashram's bank account — Razorpay settles payments in batches, days
  /// after capture, so `status: 'completed'` (payment captured) and
  /// settlement are genuinely different events. Only ever set from Razorpay's
  /// own settlement-reconciliation data (razorpay-settlement.service.ts) —
  /// never inferred or guessed.
  settlementStatus      SettlementStatus?   @map("settlement_status")
  /// Razorpay's settlement batch id this payment was included in, once known.
  razorpaySettlementId  String?             @map("razorpay_settlement_id")
  /// Bank UTR (Unique Transaction Reference) for that settlement batch — the
  /// same reference that appears on the Ashram's actual bank statement, the
  /// most concrete proof a payment reached the account.
  razorpaySettlementUtr String?             @map("razorpay_settlement_utr")
  settledAt             DateTime?           @map("settled_at")
  /// From Razorpay's `amount_refunded` (paise), converted to rupees. 0/null
  /// means no refund; less than `amount` means partially refunded.
  refundAmount          Decimal?            @map("refund_amount") @db.Decimal(12, 2)
  /// Last time this donation's payment/settlement fields were successfully
  /// refreshed from Razorpay — shown in the admin UI so "Unknown" settlement
  /// status can be distinguished from "checked recently, still pending."
  paymentSyncedAt       DateTime?           @map("payment_synced_at")
  /// Client-supplied key (one per checkout attempt) so `/donations/initiate`
  /// is safe to retry on network failure without creating duplicate pending
  /// rows (documentation/13-API-Requirements.md §7).
  idempotencyKey        String?             @unique @map("idempotency_key")
  status                DonationStatus      @default(pending)
  source                DonationSource      @default(online)
  frequency             DonationFrequency   @default(one_time)
  /// Set only for a recurring charge created from the `subscription.charged`
  /// webhook (subscription.service.ts) — each charge still gets its own
  /// Donation row (never overwrites a prior one), linked back to the pledge.
  subscriptionId        String?             @map("subscription_id")
  internalNote          String?             @map("internal_note")
  createdAt             DateTime            @default(now()) @map("created_at")
  completedAt           DateTime?           @map("completed_at")
  bankTransferClaim     BankTransferRecord?
  appeal                Appeal?             @relation(fields: [appealId], references: [id])
  category              DonationCategory    @relation(fields: [categoryId], references: [id])
  donor                 Donor               @relation(fields: [donorId], references: [id])
  subscription          DonorSubscription?  @relation(fields: [subscriptionId], references: [id])
  receipt               Receipt?

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([donorId])
  @@index([frequency])
  @@index([subscriptionId])
  @@index([appealId], map: "donation_appeal_id_fkey")
  @@map("donation")
}

/// A donor's automatic-monthly pledge — one Razorpay Subscription mandate.
/// Every successful recurring charge against it is recorded as its own
/// `Donation` row (never overwrites history), linked via `Donation.subscriptionId`.
model DonorSubscription {
  id                     String             @id @default(uuid())
  donorId                String             @map("donor_id")
  categoryId             String             @map("category_id")
  razorpayPlanId         String             @map("razorpay_plan_id")
  razorpaySubscriptionId String             @unique @map("razorpay_subscription_id")
  amount                 Decimal            @db.Decimal(12, 2)
  currency               String             @default("INR")
  status                 SubscriptionStatus @default(created)
  startDate              DateTime           @default(now()) @map("start_date")
  nextChargeAt           DateTime?          @map("next_charge_at")
  cancelledAt            DateTime?          @map("cancelled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  donor                  Donor              @relation(fields: [donorId], references: [id])
  category               DonationCategory   @relation(fields: [categoryId], references: [id])
  donations              Donation[]

  @@index([donorId])
  @@index([status])
  @@map("donor_subscription")
}

/// Idempotency ledger for the Razorpay webhook (design/13-API-Architecture.md
/// §5): `eventId` is a SHA-256 hash of the raw webhook body, so an exact
/// redelivery (Razorpay retries on any non-2xx response) is recognized and
/// skipped rather than reprocessed into a duplicate receipt/email.
model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  payload     String   @db.LongText
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("payment_webhook_event")
}

/// One-time passcodes for the lightweight, optional donor login used only to
/// view donation history (FR-DON-07, design/13-API-Architecture.md §4.2) —
/// deliberately not a password-based account system.
model DonorOtp {
  id         String    @id @default(uuid())
  donorEmail String    @map("donor_email")
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([donorEmail, expiresAt])
  @@map("donor_otp")
}

/// A donor's self-reported "I've made a bank transfer/UPI payment" claim
/// (design/03-User-Flows.md F-03) — separate from `Donation` because it starts
/// as an unverified claim; a Finance Admin cross-checks it against the bank
/// statement and only then creates/links the authoritative `Donation` record.
model BankTransferRecord {
  id                String             @id @default(uuid())
  donorName         String             @map("donor_name")
  donorEmail        String?            @map("donor_email")
  donorPhone        String?            @map("donor_phone")
  categoryId        String             @map("category_id")
  amount            Decimal            @db.Decimal(12, 2)
  bankReferenceUtr  String?            @map("bank_reference_utr")
  submittedAt       DateTime           @default(now()) @map("submitted_at")
  status            BankTransferStatus @default(pending_verification)
  verifiedByAdminId String?            @map("verified_by_admin_id")
  linkedDonationId  String?            @unique @map("linked_donation_id")
  internalNote      String?            @map("internal_note")
  category          DonationCategory   @relation(fields: [categoryId], references: [id])
  linkedDonation    Donation?          @relation(fields: [linkedDonationId], references: [id])
  verifiedByAdmin   AdminUser?         @relation("BankTransferVerifier", fields: [verifiedByAdminId], references: [id])

  @@index([status, submittedAt])
  @@index([categoryId], map: "bank_transfer_record_category_id_fkey")
  @@index([verifiedByAdminId], map: "bank_transfer_record_verified_by_admin_id_fkey")
  @@map("bank_transfer_record")
}

model Receipt {
  id            String             @id @default(uuid())
  donationId    String             @unique @map("donation_id")
  receiptNumber String             @unique @map("receipt_number")
  pdfUrl        String?            @map("pdf_url")
  issuedAt      DateTime           @default(now()) @map("issued_at")
  receiptGeneratedAt DateTime?     @map("receipt_generated_at")
  /// Distinct from `pdfUrl`/receipt generation succeeding — each delivery
  /// channel can fail (or never attempt, when the provider isn't configured)
  /// independently of the receipt PDF itself. Null until a send is attempted
  /// (`pending` = queued, `sent` = provider accepted, `failed`/`not_configured`).
  smsStatus             SmsDeliveryStatus? @map("sms_status")
  emailStatus           SmsDeliveryStatus? @map("email_status")
  emailSentAt           DateTime?          @map("email_sent_at")
  emailMessageId        String?            @map("email_message_id")
  emailFailureReason    String?            @map("email_failure_reason") @db.VarChar(500)
  whatsappStatus        SmsDeliveryStatus? @map("whatsapp_status")
  whatsappSentAt        DateTime?          @map("whatsapp_sent_at")
  whatsappMessageId     String?            @map("whatsapp_message_id")
  whatsappFailureReason String?            @map("whatsapp_failure_reason") @db.VarChar(500)
  /// Organisation copy (ORG_RECEIPT_EMAIL, e.g. sysaorg1@gmail.com) — tracked
  /// separately from the donor's own receipt email above so one channel
  /// failing never masks or re-triggers the other.
  orgEmailStatus        SmsDeliveryStatus? @map("org_email_status")
  orgEmailSentAt        DateTime?          @map("org_email_sent_at")
  orgEmailMessageId     String?            @map("org_email_message_id")
  orgEmailFailureReason String?            @map("org_email_failure_reason") @db.VarChar(500)
  updatedAt             DateTime           @updatedAt @map("updated_at")
  donation              Donation           @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@map("receipt")
}

model Appeal {
  id                String           @id @default(uuid())
  categoryId        String           @map("category_id")
  titleEn           String           @map("title_en")
  titleTe           String?          @map("title_te")
  descriptionEn     String?          @map("description_en")
  descriptionTe     String?          @map("description_te")
  targetAmount      Decimal          @map("target_amount") @db.Decimal(12, 2)
  raisedAmountCache Decimal          @default(0.00) @map("raised_amount_cache") @db.Decimal(12, 2)
  startDate         DateTime?        @map("start_date") @db.Date
  endDate           DateTime?        @map("end_date") @db.Date
  status            AppealStatus     @default(active)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  category          DonationCategory @relation(fields: [categoryId], references: [id])
  donations         Donation[]

  @@index([categoryId], map: "appeal_category_id_fkey")
  @@map("appeal")
}

model CommitteeMember {
  id           String    @id @default(uuid())
  name         String
  designation  String
  displayOrder Int       @map("display_order")
  photoUrl     String?   @map("photo_url")
  bioEn        String?   @map("bio_en")
  bioTe        String?   @map("bio_te")
  /// Verified against WEBSITE_CONTENT_AUDIT.md §2 (Webpage.docx) — resolves the
  /// earlier docs/DOCUMENT_ANALYSIS.md conflict between two prior source
  /// documents by matching the committee-list numbers, now confirmed by a
  /// third, client-designated primary source.
  mobile       String?   @map("mobile")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([displayOrder])
  @@index([deletedAt])
  @@map("committee_member")
}

/// Blog/News posts. `type` is retained from Phase 3 for backward compatibility,
/// but Phase 5 introduces a dedicated, richer `Event` model (below) for actual
/// events (categories, registrations, attendance) — new code should only create
/// rows here with `type = news`.
model EventNewsPost {
  id                String     @id @default(uuid())
  type              PostType
  titleEn           String     @map("title_en")
  titleTe           String?    @map("title_te")
  bodyEn            String?    @map("body_en") @db.Text
  bodyTe            String?    @map("body_te") @db.Text
  slug              String     @unique
  eventDate         DateTime?  @map("event_date") @db.Date
  publishedAt       DateTime?  @map("published_at")
  status            PostStatus @default(draft)
  featuredImageUrl  String?    @map("featured_image_url")
  /// News-only (`type='news'`) categorization — Phase 6 public site
  /// requirement (category filter + tags). Nullable/empty on events, which
  /// don't use this field.
  category          String?
  /// JSON array of strings (e.g. `["annadanam","medical camp"]`) — MySQL has
  /// no native scalar-array column type (PostgreSQL's `String[]` has no
  /// direct equivalent), so this is stored as a JSON array instead. The
  /// public API contract is unchanged: every consumer still receives/sends a
  /// plain `string[]` over HTTP (see MYSQL_MIGRATION_REPORT.md).
  tags              String     @db.LongText
  metaTitleEn       String?    @map("meta_title_en")
  metaDescriptionEn String?    @map("meta_description_en")
  authorAdminId     String?    @map("author_admin_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")
  author            AdminUser? @relation("PostAuthor", fields: [authorAdminId], references: [id])

  @@index([type, publishedAt])
  @@index([deletedAt])
  @@index([authorAdminId], map: "event_news_post_author_admin_id_fkey")
  @@map("event_news_post")
}

model GalleryAlbum {
  id           String        @id @default(uuid())
  nameEn       String        @map("name_en")
  nameTe       String?       @map("name_te")
  category     String?
  /// Optional link so an album can double as an event's photo gallery
  /// ("Event Gallery" — Phase 5 Event module requirement).
  eventId      String?       @map("event_id")
  displayOrder Int           @default(0) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  event        Event?        @relation(fields: [eventId], references: [id])
  items        GalleryItem[]

  @@index([deletedAt])
  @@index([eventId], map: "gallery_album_event_id_fkey")
  @@map("gallery_album")
}

model GalleryItem {
  id                 String       @id @default(uuid())
  albumId            String       @map("album_id")
  mediaType          MediaType    @map("media_type")
  mediaUrl           String       @map("media_url")
  /// Cloudinary asset id — needed to delete/re-transform the asset later
  /// (not derivable from `mediaUrl` alone once transformations are applied).
  cloudinaryPublicId String?      @map("cloudinary_public_id")
  altTextEn          String?      @map("alt_text_en")
  altTextTe          String?      @map("alt_text_te")
  displayOrder       Int          @default(0) @map("display_order")
  createdAt          DateTime     @default(now()) @map("created_at")
  deletedAt          DateTime?    @map("deleted_at")
  album              GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, displayOrder])
  @@index([deletedAt])
  @@map("gallery_item")
}

model Volunteer {
  id           String                 @id @default(uuid())
  name         String
  email        String
  phone        String
  registeredAt DateTime               @default(now()) @map("registered_at")
  applications VolunteerApplication[]
  assignments  VolunteerAssignment[]

  @@index([email])
  @@map("volunteer")
}

model VolunteerApplication {
  id                 String                     @id @default(uuid())
  volunteerId        String                     @map("volunteer_id")
  type               VolunteerApplicationType
  academicBackground String?                    @map("academic_background")
  areaOfInterest     String?                    @map("area_of_interest")
  resumeUrl          String?                    @map("resume_url")
  status             VolunteerApplicationStatus @default(submitted)
  internalNote       String?                    @map("internal_note")
  reviewedBy         String?                    @map("reviewed_by")
  submittedAt        DateTime                   @default(now()) @map("submitted_at")
  statusUpdatedAt    DateTime?                  @updatedAt @map("status_updated_at")
  reviewer           AdminUser?                 @relation("ApplicationReviewer", fields: [reviewedBy], references: [id])
  volunteer          Volunteer                  @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reviewedBy], map: "volunteer_application_reviewed_by_fkey")
  @@index([volunteerId], map: "volunteer_application_volunteer_id_fkey")
  @@map("volunteer_application")
}

model DocumentRepo {
  id                 String           @id @default(uuid())
  category           DocumentCategory
  titleEn            String           @map("title_en")
  titleTe            String?          @map("title_te")
  fileUrl            String           @map("file_url")
  cloudinaryPublicId String?          @map("cloudinary_public_id")
  publishedDate      DateTime?        @map("published_date") @db.Date
  publicVisible      Boolean          @default(false) @map("public_visible")
  uploadedBy         String?          @map("uploaded_by")
  createdAt          DateTime         @default(now()) @map("created_at")
  deletedAt          DateTime?        @map("deleted_at")
  uploader           AdminUser?       @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  @@index([category, publicVisible])
  @@index([deletedAt])
  @@index([uploadedBy], map: "document_repo_uploaded_by_fkey")
  @@map("document_repo")
}

model ContactSubmission {
  id          String                  @id @default(uuid())
  name        String
  email       String
  phone       String?
  message     String
  status      ContactSubmissionStatus @default(new)
  submittedAt DateTime                @default(now()) @map("submitted_at")

  @@map("contact_submission")
}

/// Public website newsletter signup (Phase 6) — deliberately minimal (just an
/// email + subscribed flag) since no email-campaign/newsletter-sending system
/// exists in this project's scope yet; this only captures interest.
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  subscribed     Boolean   @default(true)
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@map("newsletter_subscriber")
}

model PageContent {
  id        String     @id @default(uuid())
  pageKey   String     @unique @map("page_key")
  blocksEn  String     @map("blocks_en") @db.LongText
  blocksTe  String?    @map("blocks_te") @db.LongText
  updatedAt DateTime   @updatedAt @map("updated_at")
  updatedBy String?    @map("updated_by")
  editor    AdminUser? @relation("PageContentEditor", fields: [updatedBy], references: [id])

  @@index([updatedBy], map: "page_content_updated_by_fkey")
  @@map("page_content")
}

model Testimonial {
  id           String    @id @default(uuid())
  authorName   String    @map("author_name")
  authorRole   String?   @map("author_role")
  quoteEn      String    @map("quote_en")
  quoteTe      String?   @map("quote_te")
  photoUrl     String?   @map("photo_url")
  displayOrder Int       @default(0) @map("display_order")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([active, displayOrder])
  @@index([deletedAt])
  @@map("testimonial")
}

model HeroBanner {
  id           String    @id @default(uuid())
  titleEn      String    @map("title_en")
  titleTe      String?   @map("title_te")
  subtitleEn   String?   @map("subtitle_en")
  subtitleTe   String?   @map("subtitle_te")
  imageUrl     String    @map("image_url")
  ctaLabelEn   String?   @map("cta_label_en")
  ctaLabelTe   String?   @map("cta_label_te")
  ctaUrl       String?   @map("cta_url")
  displayOrder Int       @default(0) @map("display_order")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([active, displayOrder])
  @@index([deletedAt])
  @@map("hero_banner")
}

model SocialMediaLink {
  id           String         @id @default(uuid())
  platform     SocialPlatform @unique
  url          String
  displayOrder Int            @default(0) @map("display_order")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("social_media_link")
}

/// Self-referencing for a single level of nested (dropdown) menus — matches
/// the primary/secondary nav split in design/01-Information-Architecture.md §4-5.
model NavigationMenuItem {
  id           String               @id @default(uuid())
  labelEn      String               @map("label_en")
  labelTe      String?              @map("label_te")
  url          String
  location     NavLocation
  parentId     String?              @map("parent_id")
  displayOrder Int                  @default(0) @map("display_order")
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  parent       NavigationMenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationMenuItem[] @relation("MenuHierarchy")

  @@index([location, displayOrder])
  @@index([deletedAt])
  @@index([parentId], map: "navigation_menu_item_parent_id_fkey")
  @@map("navigation_menu_item")
}

/// Singleton (always a single row, id = "default") — site-wide configuration:
/// Website Settings, Contact Information, and SEO Settings defaults, per
/// design/09-Admin-Modules.md §16 "System Settings" and the Contact Info
/// Editor in §5. Modeled as one row rather than a generic key-value table
/// because the field set is small, fixed, and known in advance.
model SiteSettings {
  id                     String     @id @default("default")
  siteNameEn             String     @default("Sai Yadadri Seva Ashram") @map("site_name_en")
  siteNameTe             String?    @map("site_name_te")
  taglineEn              String?    @map("tagline_en")
  taglineTe              String?    @map("tagline_te")
  logoUrl                String?    @map("logo_url")
  faviconUrl             String?    @map("favicon_url")
  contactAddressEn       String?    @map("contact_address_en")
  contactAddressTe       String?    @map("contact_address_te")
  contactPhone           String?    @map("contact_phone")
  contactEmail           String?    @map("contact_email")
  contactHoursEn         String?    @map("contact_hours_en")
  whatsappNumber         String?    @map("whatsapp_number")
  mapLatitude            Decimal?   @map("map_latitude") @db.Decimal(9, 6)
  mapLongitude           Decimal?   @map("map_longitude") @db.Decimal(9, 6)
  defaultMetaTitle       String?    @map("default_meta_title")
  defaultMetaDescription String?    @map("default_meta_description")
  defaultOgImageUrl      String?    @map("default_og_image_url")
  footerTextEn           String?    @map("footer_text_en")
  footerTextTe           String?    @map("footer_text_te")
  copyrightText          String?    @map("copyright_text")
  maintenanceMode        Boolean    @default(false) @map("maintenance_mode")
  /// Bank transfer / UPI details shown on the public Donate page — nullable
  /// like every other settings field (Phase 6), never fabricated defaults.
  bankAccountName        String?    @map("bank_account_name")
  bankAccountNumber      String?    @map("bank_account_number")
  bankIfscCode           String?    @map("bank_ifsc_code")
  bankName               String?    @map("bank_name")
  bankBranch             String?    @map("bank_branch")
  upiId                  String?    @map("upi_id")
  upiQrImageUrl          String?    @map("upi_qr_image_url")
  updatedAt              DateTime   @updatedAt @map("updated_at")
  updatedBy              String?    @map("updated_by")
  editor                 AdminUser? @relation("SiteSettingsEditor", fields: [updatedBy], references: [id])

  @@index([updatedBy], map: "site_settings_updated_by_fkey")
  @@map("site_settings")
}

/// Covers both "Activities" and "Services" from the Phase 5 CMS list — no
/// separate "Services" concept exists anywhere in the Phase 1/2 source-of-truth
/// documents, so the two are modeled as one entity rather than inventing a
/// second, functionally-identical table (see DEVELOPMENT_PROGRESS.md).
model Activity {
  id               String            @id @default(uuid())
  slug             String            @unique
  titleEn          String            @map("title_en")
  titleTe          String?           @map("title_te")
  descriptionEn    String?           @map("description_en") @db.Text
  descriptionTe    String?           @map("description_te") @db.Text
  iconOrImageUrl   String?           @map("icon_or_image_url")
  linkedCategoryId String?           @map("linked_category_id")
  displayOrder     Int               @default(0) @map("display_order")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  linkedCategory   DonationCategory? @relation(fields: [linkedCategoryId], references: [id])

  @@index([active, displayOrder])
  @@index([deletedAt])
  @@index([linkedCategoryId], map: "activity_linked_category_id_fkey")
  @@map("activity")
}

model VolunteerAssignment {
  id                String           @id @default(uuid())
  volunteerId       String           @map("volunteer_id")
  titleEn           String           @map("title_en")
  descriptionEn     String?          @map("description_en")
  assignedDate      DateTime         @map("assigned_date") @db.Date
  status            AssignmentStatus @default(assigned)
  assignedByAdminId String?          @map("assigned_by_admin_id")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  assignedByAdmin   AdminUser?       @relation("AssignmentAssignedBy", fields: [assignedByAdminId], references: [id])
  volunteer         Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId, status])
  @@index([assignedByAdminId], map: "volunteer_assignment_assigned_by_admin_id_fkey")
  @@map("volunteer_assignment")
}

model EventCategory {
  id        String    @id @default(uuid())
  nameEn    String    @map("name_en")
  nameTe    String?   @map("name_te")
  slug      String    @unique
  active    Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")
  events    Event[]

  @@index([deletedAt])
  @@map("event_category")
}

model Event {
  id                   String              @id @default(uuid())
  categoryId           String?             @map("category_id")
  titleEn              String              @map("title_en")
  titleTe              String?             @map("title_te")
  descriptionEn        String?             @map("description_en") @db.Text
  descriptionTe        String?             @map("description_te") @db.Text
  slug                 String              @unique
  startDate            DateTime            @map("start_date")
  endDate              DateTime?           @map("end_date")
  location             String?
  capacity             Int?
  registrationDeadline DateTime?           @map("registration_deadline")
  featuredImageUrl     String?             @map("featured_image_url")
  status               EventStatus         @default(draft)
  metaTitleEn          String?             @map("meta_title_en")
  metaDescriptionEn    String?             @map("meta_description_en")
  createdByAdminId     String?             @map("created_by_admin_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  category             EventCategory?      @relation(fields: [categoryId], references: [id])
  createdByAdmin       AdminUser?          @relation("EventCreatedBy", fields: [createdByAdminId], references: [id])
  registrations        EventRegistration[]
  galleryAlbums        GalleryAlbum[]

  @@index([status, startDate])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([createdByAdminId], map: "event_created_by_admin_id_fkey")
  @@map("event")
}

model EventRegistration {
  id           String                  @id @default(uuid())
  eventId      String                  @map("event_id")
  name         String
  email        String
  phone        String?
  registeredAt DateTime                @default(now()) @map("registered_at")
  status       EventRegistrationStatus @default(registered)
  /// "Attendance" tracking — Phase 5 Event module requirement, folded into the
  /// registration record rather than a separate table since a check-in is
  /// always 1:1 with exactly one registration.
  checkedIn    Boolean                 @default(false) @map("checked_in")
  checkedInAt  DateTime?               @map("checked_in_at")
  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("event_registration")
}

enum DonorTier {
  one_time
  monthly
  major
  csr
}

enum PaymentMethod {
  upi
  card
  netbanking
  wallet
  bank_transfer_manual
  cash
  cheque
}

enum DonationStatus {
  pending
  completed
  failed
  refunded
}

/// `unknown` is a genuinely distinct, honest state — Razorpay's settlement
/// recon report for a payment's month may not yet be available (too recent),
/// or the payment hasn't been fetched from Razorpay at all yet. It must never
/// be presented to an admin as either "not settled" or "settled".
enum SettlementStatus {
  not_settled
  pending
  settled
  failed
  unknown
}

enum DonationSource {
  online
  manual
}

/// Distinguishes a single gift from a recurring pledge — the "One-Time
/// Donations" vs. "Monthly Donations" split requested for Phase 5. Actual
/// recurring-charge automation (re-billing a monthly donor) is a Razorpay
/// Subscriptions integration deferred to the Donation Platform phase
/// (documentation/03-Functional-Requirements.md FR-DON-08); this field lets
/// the admin classify/report on a donation's intended frequency starting now.
enum DonationFrequency {
  one_time
  monthly
}

/// Mirrors Razorpay's own subscription status vocabulary
/// (https://razorpay.com/docs/payments/subscriptions/), set from the
/// `subscription.*` webhook events (webhook.service.ts).
enum SubscriptionStatus {
  created
  authenticated
  active
  pending
  halted
  paused
  cancelled
  completed
  expired
}

enum BankTransferStatus {
  pending_verification
  verified
  rejected
}

/// Whether a receipt notification (SMS, email, or WhatsApp) was accepted by
/// the configured provider — not the same as the provider confirming actual
/// handset/inbox delivery, which most REST gateways don't report synchronously.
enum SmsDeliveryStatus {
  pending
  sent
  failed
  not_configured
}

enum AppealStatus {
  active
  completed
  archived
}

enum PostType {
  event
  news
}

enum PostStatus {
  draft
  published
  archived
}

enum MediaType {
  image
  video
}

enum VolunteerApplicationType {
  volunteer
  internship
}

enum VolunteerApplicationStatus {
  submitted
  under_review
  accepted
  not_selected
}

/// `certificate_12ab` covers the client's "12A" ask — 12AB is the current form
/// of that certificate under Indian tax law since the 12A regime was
/// superseded; no separate `certificate_12a` value is added to avoid modeling
/// a form that no longer exists.
enum DocumentCategory {
  registration_certificate
  certificate_12ab
  certificate_80g
  pan_card
  annual_report
  audit_report
  financial_statement
}

enum ContactSubmissionStatus {
  new
  in_progress
  resolved
}

enum SocialPlatform {
  facebook
  instagram
  twitter
  youtube
  linkedin
  whatsapp
}

enum NavLocation {
  header
  footer
}

enum AssignmentStatus {
  assigned
  in_progress
  completed
  cancelled
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

enum EventRegistrationStatus {
  registered
  cancelled
  waitlisted
}
