# ==============================================================================
# Production environment for the Node.js API host (not Hostinger static hosting).
# Copy these keys into the Node host's env UI or api/.env on that machine.
# Never commit the filled-in file. Never put these values in the website export.
# There is no JWT_SECRET variable — this app uses the two names below.
# ==============================================================================

NODE_ENV=production
# The host usually injects PORT. BIND_HOST must be 0.0.0.0 behind a proxy.
# PORT=4000
BIND_HOST=0.0.0.0

# Public URL as browsers and Razorpay see it (Node API on api.sysa.in).
API_URL=https://api.sysa.in
WEB_URL=https://sysa.in
CORS_ORIGIN=https://sysa.in,https://www.sysa.in
# Set COOKIE_CROSS_SITE=true because API is on api.sysa.in and website is on sysa.in.
COOKIE_CROSS_SITE=true

# Hostinger MySQL. Enable Remote MySQL for this Node host's IP first.
# Do not use local sysa_local_dev.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=

# Organisation copy of every verified donation receipt (not a secret).
ORG_RECEIPT_EMAIL=sysaorg1@gmail.com
# Leave unset in production (resolves to live with rzp_live_ keys, dry_run
# with rzp_test_ keys). Set to dry_run to silence all donor notifications.
# NOTIFICATIONS_MODE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MSG91 (WhatsApp receipts + SMS).
# MSG91_AUTHKEY is the canonical secret (backs both WhatsApp and SMS). Never commit it.
MSG91_AUTHKEY=
MSG91_WHATSAPP_NUMBER=+919490118877
MSG91_WHATSAPP_INTEGRATED_NUMBER=919490118877
MSG91_WABA_ID=1511221500759195
MSG91_WHATSAPP_TEMPLATE_NAME=sysa_general_update
MSG91_WHATSAPP_TEMPLATE_ID=546722
MSG91_WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional variable override JSON — unset uses defaults
# MSG91_WHATSAPP_TEMPLATE_VARS=
SMS_SENDER_ID=SYSAOF
# SMS DLT Template ID (the 19-digit DLT template ID is for SMS only, not WhatsApp)
SMS_DLT_TEMPLATE_ID=1477179051631924585
SMS_DLT_PRINCIPAL_ENTITY_ID=1401717840000080834

# Optional fallback Meta WhatsApp Cloud API (used only if MSG91 is not configured)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
