# ==============================================================================
# Production environment for the Node.js API host (not Hostinger static hosting).
# Copy these keys into the Node host's env UI or api/.env on that machine.
# Never commit the filled-in file. Never put these values in the website export.
# There is no JWT_SECRET variable — this app uses the two names below.
# ==============================================================================

NODE_ENV=production
# The host usually injects PORT. BIND_HOST must be 0.0.0.0 behind a proxy.
# PORT=4000
BIND_HOST=0.0.0.0

# Public URL as browsers and Razorpay see it (Node API on api.sysa.in).
API_URL=https://api.sysa.in
WEB_URL=https://sysa.in
CORS_ORIGIN=https://sysa.in,https://www.sysa.in
# Set COOKIE_CROSS_SITE=true because API is on api.sysa.in and website is on sysa.in.
COOKIE_CROSS_SITE=true

# Hostinger MySQL. Enable Remote MySQL for this Node host's IP first.
# Do not use local sysa_local_dev.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Donation status / receipt link tokens (see src/lib/donor-jwt.ts).
# DONATION_TOKEN_SECRET: own signing key (>= 32 chars); rotating it revokes
# every donation link without logging admins out. Unset = derived from
# JWT_ACCESS_SECRET. DONATION_TOKENS_ISSUED_AFTER (ISO time) revokes every
# donation link and emailed receipt link issued before it.
# DONATION_TOKEN_LEGACY_UNTIL: last moment old non-expiring links work.
DONATION_TOKEN_SECRET=
DONATION_TOKEN_TTL_DAYS=30
DONATION_TOKENS_ISSUED_AFTER=
DONATION_TOKEN_LEGACY_UNTIL=2026-11-15T00:00:00Z

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=

# Organisation copy of every verified donation receipt (not a secret).
ORG_RECEIPT_EMAIL=sysaorg1@gmail.com
# Unset = dry_run: NO receipt email/WhatsApp/SMS is sent. Set to `live` only
# after the controlled live test passes (see DEPLOYMENT checklist).
NOTIFICATIONS_MODE=dry_run

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MSG91 (WhatsApp receipts + SMS).
# MSG91_AUTHKEY is the canonical secret (backs both WhatsApp and SMS). Never commit it.
MSG91_AUTHKEY=
MSG91_WHATSAPP_NUMBER=+919490118877
MSG91_WHATSAPP_INTEGRATED_NUMBER=919490118877
MSG91_WABA_ID=1511221500759195
# Transactional receipt template (UTILITY): {{1}} donor name, {{2}} amount,
# {{3}} receipt number — mapped automatically. Never use sysa_general_update
# (marketing) for receipts; the API refuses it.
MSG91_WHATSAPP_TEMPLATE_NAME=sysa_donation_receipt
# MSG91 id of sysa_donation_receipt (verified). 546722 is sysa_general_update.
MSG91_WHATSAPP_TEMPLATE_ID=567627
# `true` only after the template is confirmed APPROVED by Meta.
MSG91_WHATSAPP_TEMPLATE_APPROVED=
# MSG91 WhatsApp delivery reports → POST /api/v1/webhooks/msg91/whatsapp.
# Random secret (>=16 chars); configure the same value in MSG91's webhook
# settings as header x-sysa-webhook-token (or ?token=). Unset = disabled.
MSG91_WEBHOOK_SECRET=
MSG91_WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional variable override JSON — unset uses defaults
# Receipt PDF on WhatsApp: needs a Meta-approved UTILITY template with a
# DOCUMENT header (sysa_donation_receipt is text-only). Once approved, set
# MSG91_WHATSAPP_TEMPLATE_NAME/_ID/_APPROVED to it and map the header, e.g.
# MSG91_WHATSAPP_TEMPLATE_VARS={"header_1":"document","body_1":"customerName","body_2":"amountFormatted","body_3":"receiptNumber"}
# The PDF is then rendered per send, uploaded privately to Cloudinary
# (CLOUDINARY_* required) and MSG91 gets a signed link valid for 24 hours.
# MSG91_WHATSAPP_TEMPLATE_VARS=
SMS_SENDER_ID=SYSAOF
# SMS DLT Template ID (the 19-digit DLT template ID is for SMS only, not WhatsApp)
# MSG91's own template id (linked to DLT template 1477179051631924585).
SMS_DLT_TEMPLATE_ID=6abd3c3362121d42e10c6c22
# Flow variable names (no ##), verified against the flow text.
SMS_PROVIDER_TEMPLATE_VARS={"donorName":"name","amount":"amount","receiptNumber":"receipt"}
# `true` only once the DLT content template is verified as matching.
SMS_DLT_CONTENT_VERIFIED=
SMS_DLT_PRINCIPAL_ENTITY_ID=1401717840000080834

# Optional fallback Meta WhatsApp Cloud API (used only if MSG91 is not configured)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
