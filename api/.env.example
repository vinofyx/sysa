# ==============================================================================
# Sai Yadadri Seva Ashram Platform — Backend API Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- Runtime ---
NODE_ENV=development
# Hostinger Node.js / Docker / any PaaS injects PORT. Do not hardcode a vendor port.
PORT=4000
# Bind address. 0.0.0.0 is required so reverse proxies can reach the process.
# Named BIND_HOST so it does not collide with a system HOST variable.
BIND_HOST=0.0.0.0
# Public origin of this API (no /api/v1 suffix). Local: http://localhost:4000
# Production same-site: https://sysa.in  |  subdomain: https://api.sysa.in
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Database (MySQL 8.0+ via Prisma — utf8mb4 / utf8mb4_0900_ai_ci, see
# MYSQL_MIGRATION_REPORT.md) ---
# Local Docker Compose default — see docker-compose.yml. Note: no `?schema=`
# query param — unlike PostgreSQL, MySQL has no separate "schema within a
# database" concept, so it's omitted here (was present before the migration).
DATABASE_URL="mysql://sysa_user:sysa_password@localhost:3306/sysa_db"

# --- Auth (JWT) ---
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Donation status / receipt link tokens (see src/lib/donor-jwt.ts).
# DONATION_TOKEN_SECRET: own signing key (>= 32 chars); rotating it revokes
# every donation link without logging admins out. Unset = derived from
# JWT_ACCESS_SECRET. DONATION_TOKENS_ISSUED_AFTER (ISO time) revokes every
# donation link and emailed receipt link issued before it.
# DONATION_TOKEN_LEGACY_UNTIL: last moment old non-expiring links work.
DONATION_TOKEN_SECRET=
DONATION_TOKEN_TTL_DAYS=30
DONATION_TOKENS_ISSUED_AFTER=
DONATION_TOKEN_LEGACY_UNTIL=2026-11-15T00:00:00Z
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Comma-separated allow-list. Production must include the live website origin.
# CORS_ORIGIN=https://sysa.in,https://www.sysa.in
# Local: website is :3030 (see website/package.json `next dev -p 3030`), API is :5050.
# CORS_ORIGIN=http://localhost:3030,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Cloudinary (media & document storage) ---
# See documentation/11-Technology-Stack.md and 16-Assumptions-and-Dependencies.md
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payment gateway) ---
# Pending client Razorpay merchant KYC — see documentation/16-Assumptions-and-Dependencies.md D-01
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (transactional — donation receipts, notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Alias for SMTP_USER — if both are set, SMTP_USER wins.
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@sysaindia.org
# Alias for EMAIL_FROM — if both are set, SMTP_FROM wins.
SMTP_FROM=
# Alias for SMTP_FROM.
SMTP_FROM_EMAIL=

# Organisation copy of every verified donation receipt (not a secret).
ORG_RECEIPT_EMAIL=sysaorg1@gmail.com
# Post-payment notifications: live | dry_run. Unset = dry_run everywhere —
# nothing is sent until this is explicitly `live`.
NOTIFICATIONS_MODE=dry_run

# --- MSG91 account (backend only — NEVER in website/.env* or client code) ---
# Single account authkey. Backs WhatsApp and SMS unless MSG91_WHATSAPP_AUTHKEY /
# SMS_PROVIDER_API_KEY are set. Rotate it if it was ever pasted into chat,
# a ticket, a log, or a commit.
MSG91_AUTHKEY=

# --- WhatsApp (donation receipt delivery — MSG91 WhatsApp API) ---
# Primary provider. Do not reuse SMS_DLT_TEMPLATE_ID here — WhatsApp templates
# are approved separately in the MSG91 WhatsApp dashboard.
# Business SENDER number (recipients always come from the donor record).
# Alias: MSG91_WHATSAPP_INTEGRATED_NUMBER. Formatting is stripped to digits.
MSG91_WHATSAPP_NUMBER=919490118877
MSG91_WABA_ID=1511221500759195
# Transactional receipt template (UTILITY): {{1}} donor name, {{2}} amount,
# {{3}} receipt number — mapped automatically. Never use sysa_general_update
# (marketing) for receipts; the API refuses it.
MSG91_WHATSAPP_TEMPLATE_NAME=sysa_donation_receipt
# MSG91 id of sysa_donation_receipt (verified via the inspect script; Meta id
# 28775572638768216). 546722 is sysa_general_update.
MSG91_WHATSAPP_TEMPLATE_ID=567627
MSG91_WHATSAPP_TEMPLATE_LANGUAGE=en
MSG91_WHATSAPP_TEMPLATE_NAMESPACE=
# Optional overrides of the channel-specific names above.
MSG91_WHATSAPP_AUTHKEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
# JSON map of template component -> receipt field. Do NOT guess: run
#   npx tsx scripts/msg91-inspect-whatsapp-template.ts
# and fill in the keys it prints. Allowed fields: customerName,
# amountFormatted, receiptNumber, donationDate, paymentId, document.
# Unset = default '{"body_1":"customerName","body_2":"amountFormatted","body_3":"receiptNumber"}'
# Receipt PDF on WhatsApp: sysa_donation_receipt is text-only. The DOCUMENT
# header template sysa_donation_receipt_pdf (MSG91 id 571129, Meta id
# 1618325329699944, namespace f8f2a2af_29b5_4fab_a60c_d1ba6dbfd04f) was
# verified APPROVED via the inspect script on 2026-10-16. To switch, set
#   MSG91_WHATSAPP_TEMPLATE_NAME=sysa_donation_receipt_pdf
#   MSG91_WHATSAPP_TEMPLATE_ID=571129
#   MSG91_WHATSAPP_TEMPLATE_NAMESPACE=f8f2a2af_29b5_4fab_a60c_d1ba6dbfd04f
# and leave TEMPLATE_VARS unset — its header_1=document, body_1..3 mapping is
# built in.
# The PDF is then rendered per send, uploaded privately to Cloudinary
# (CLOUDINARY_* required) and MSG91 gets a signed link valid for 24 hours.
MSG91_WHATSAPP_TEMPLATE_VARS=
# Live WhatsApp sends are refused until this is `true`. Set it ONLY after the
# inspect script shows the template status as APPROVED by Meta — "Enabled" in
# the MSG91 dashboard is not proof of approval.
# sysa_donation_receipt (567627) was verified APPROVED via the inspect script on
# 2026-10-14 — set `true` in each environment that should send live WhatsApp.
MSG91_WHATSAPP_TEMPLATE_APPROVED=
# MSG91 WhatsApp delivery reports → POST /api/v1/webhooks/msg91/whatsapp.
# Random secret (>=16 chars); configure the same value in MSG91's webhook
# settings as header x-sysa-webhook-token (or ?token=). Unset = disabled.
MSG91_WEBHOOK_SECRET=
# Optional Meta Cloud API fallback if MSG91 WhatsApp is not configured.
# Never put WHATSAPP_ACCESS_TOKEN in frontend env files.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- SMS (donation receipt delivery — MSG91 Flow API) ---
# Optional: without these set, sms.service.ts logs and no-ops (same fail-open
# pattern as SMTP above) rather than pretending a message was delivered.
# URL defaults to MSG91's own Flow endpoint if left blank — only set to
# override with a different regional/enterprise MSG91 URL.
SMS_PROVIDER_API_URL=
# Falls back to MSG91_AUTHKEY when blank.
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=SYSAOF
# DLT-approved template/flow id from the MSG91 dashboard — required for any
# send to actually go out; MSG91's Flow API has no freeform-message fallback.
# MSG91's own 24-char template id (NOT the 19-digit DLT id). This one is
# linked in MSG91 to DLT template 1477179051631924585.
# (No TM ID is configured — add one only once MSG91/DLT confirms it is needed.)
SMS_DLT_TEMPLATE_ID=6abd3c3362121d42e10c6c22
# Live SMS is refused until this is `true`: set it only once the DLT content
# template, sender ID and PE-TM chain are verified approved AND matching.
SMS_DLT_CONTENT_VERIFIED=
# Flow variable names WITHOUT the ## (the Flow API keys). Verified against
# flow 6abd3c3362121d42e10c6c22 ("Dear ##name## ... Rs. ##amount## ...
# Receipt No: ##receipt##"); the template has no category variable.
SMS_PROVIDER_TEMPLATE_VARS={"donorName":"name","amount":"amount","receiptNumber":"receipt"}
# BSNL DLT Principal Entity ID for this organization (registered on the
# BSNL DLT operator portal / MSG91's DLT dashboard). Record-keeping only —
# MSG91's Flow API does not accept or require this value in send requests;
# it is not read by any code path.
SMS_DLT_PRINCIPAL_ENTITY_ID=1401717840000080834

# --- Logging ---
LOG_LEVEL=info

# --- Seed script (dev-only bootstrap Super Admin — see prisma/seed.ts) ---
# If unset, the seed script falls back to superadmin@sysaindia.org / ChangeMe!12345
# and prints a warning. ALWAYS set an explicit strong password for any shared/production seed.
SEED_SUPER_ADMIN_EMAIL=superadmin@sysaindia.org
SEED_SUPER_ADMIN_PASSWORD=

# --- Frontend origin allowed to read this API's cookies (auth) ---
COOKIE_DOMAIN=localhost

# Set to true only when the API is on a different site than the website
# (e.g. API at https://api.sysa.in, website at https://sysa.in). Leave
# unset/false when the browser calls https://sysa.in/api/v1 (PHP proxy or
# same-host reverse proxy). When true, leave COOKIE_DOMAIN unset entirely —
# see the comment in src/config/env.ts for why.
COOKIE_CROSS_SITE=false
