# ==============================================================================
# Sai Yadadri Seva Ashram Platform — Frontend Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Only NEXT_PUBLIC_* variables are exposed to the browser bundle.
# ==============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production Hostinger static export (baked in at build time — rebuild after change):
# NEXT_PUBLIC_API_URL=https://sysa.in
# NEXT_PUBLIC_SITE_URL=https://sysa.in
# Bare origin only — the client appends /api/v1. Never sysa.onrender.com.
# Never put RAZORPAY_KEY_SECRET, webhook secrets, SMTP, or DATABASE_URL here.

# Static-export-only: the Volunteer and Contact forms have no reachable
# SYSA backend when built for Hostinger static hosting (NEXT_PUBLIC_STATIC_EXPORT=true),
# so they POST straight to a third-party static-form provider instead
# (Formspree, Web3Forms, FormSubmit, etc.) — see lib/form-config.ts.
# Leave unset until a real provider account/endpoint exists; the forms show
# their normal error state (not a fake success) while unset.
# NEXT_PUBLIC_VOLUNTEER_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/yyyyyyyy
